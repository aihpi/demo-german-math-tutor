{
  "_comment": "Cache manifest. render_scene.py --author falls back to these when live authoring fails. `match` entries are lowercase substrings tested against the concept.",
  "entries": [
    {
      "file": "dense_vs_moe.json",
      "template": "comparison_split",
      "match": [
        "dense vs moe",
        "moe",
        "mixture of experts",
        "expert routing",
        "active parameters",
        "sparse model"
      ]
    },
    {
      "file": "ar_vs_diffusion.json",
      "template": "comparison_split",
      "match": [
        "autoregressive",
        "diffusion",
        "ar vs",
        "parallel decoding",
        "denoising",
        "tokens per forward"
      ]
    },
    {
      "file": "gradient_descent_walk.json",
      "template": "curve_plot",
      "match": [
        "gradient descent",
        "learning rate",
        "loss landscape",
        "convergence",
        "local minimum",
        "optimizer"
      ]
    },
    {
      "file": "overfitting_curves.json",
      "template": "curve_plot",
      "match": [
        "overfit",
        "underfit",
        "training vs validation",
        "generalization gap",
        "bias vs variance",
        "model complexity"
      ]
    },
    {
      "file": "transformer_pipeline.json",
      "template": "pipeline_flow",
      "match": [
        "transformer pipeline",
        "how a transformer works",
        "tokenise",
        "tokenize",
        "embedding pipeline",
        "text through a model",
        "inference pipeline"
      ]
    },
    {
      "file": "water_cycle.json",
      "template": "pipeline_flow",
      "match": [
        "water cycle",
        "evaporation",
        "precipitation",
        "hydrological"
      ]
    }
  ]
}
